Просмотр:
---
systemctl --user show-environment | grep -i proxy

Включение:
---
systemctl --user import-environment \
    http_proxy https_proxy ftp_proxy all_proxy no_proxy \
    HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY NO_PROXY

Отключение:
---
systemctl --user unset-environment \
    http_proxy https_proxy ftp_proxy all_proxy no_proxy \
    HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY NO_PROXY


Очистка кеша:
---
pkill firefox && firefox --purgecaches

или

pkill firefox
while pgrep firefox >/dev/null; do sleep 1; done
firefox --purgecaches


cat /proc/$(pidof firefox)/environ | tr '\0' '\n' | grep -i proxy

for p in $(pgrep -x firefox); do
    echo "===== $p ====="
    tr '\0' '\n' < /proc/$p/environ 2>/dev/null | grep -i proxy
done

gio launch /usr/share/applications/org.mozilla.firefox.desktop

