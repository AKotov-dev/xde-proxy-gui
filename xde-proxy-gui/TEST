Комплексная проверка
---
echo "=== DESKTOP ==="
echo "$XDG_CURRENT_DESKTOP"

echo "=== SESSION ==="
pid=$(pidof lxqt-session) #lxsession, xfce4-session, lxqt-session
tr '\0' '\n' < /proc/$pid/environ | grep -i proxy

echo "=== SYSTEMD USER ==="
systemctl --user show-environment | grep -i proxy

echo "=== TERMINAL / CLI ==="
printenv | grep -i proxy


