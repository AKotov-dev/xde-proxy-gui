[NAME]
name=xde-proxy-gui

[VERSION]
version=0.5

[RELEASE]
release=0.mrx10

[GROUP]
group=System/Configuration

[DESCRIPTION]
0=Lightweight proxy manager with GNOME-compatible live switching for XDE (XFCE, LXDE, LXQt)
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Proxy manager for XFCE, LXDE and LXQt

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/xde-proxy-gui

[LICENSE]
license=GPLv3

[DEPS]
deps=gsettings-desktop-schemas dconf dconf-editor lib64proxy-gnome gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/etc/profile.d/proxy-sync.sh
1=/etc/profile.d/xde-proxy-env.sh
2=/usr/share/icons/xde-proxy-gui.png
3=/usr/libexec/xde-proxy-gui/proxy-env.sh
4=/usr/share/applications/xde-proxy-gui.desktop
5=/usr/share/xde-proxy-gui/
6=/usr/share/doc/xde-proxy-gui/

[URL32]
url32=https://github.com/AKotov-dev/xde-proxy-gui

[PROGRAMNAME]
programname=XDE-Proxy-GUI

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

